# ==============================================================================
# PulseCare Health System - Application Environment Configuration
# ==============================================================================
# Runtime & Server
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"

# Application Security & JWT Auth
# In production on AWS, supply this via AWS Secrets Manager or Systems Manager Parameter Store
JWT_SECRET="pulsecare-production-insecure-default-change-in-aws-secrets"
JWT_EXPIRES_IN="8h"

# Relational Database Connection
# Leave empty for automatic local SQLite database (zero external dependencies).
# For AWS RDS PostgreSQL (or local Docker Compose), provide the PostgreSQL connection string:
# DATABASE_URL="postgresql://postgres:postgres_secure_pass@localhost:5432/pulsecare_db?sslmode=disable"
DATABASE_URL=

# Observability & CloudWatch Compatibility
# Levels: debug, info, warn, error
LOG_LEVEL="info"
ENABLE_CLOUDWATCH_JSON_LOGS=true

# CORS configuration (comma separated origins or * in dev)
CORS_ORIGIN="*"
